* text=auto eol=lf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.zip binary

# Verbatim FSF text. Nothing here reformats it.
/LICENSE -text

# composer.json and composer.lock DO ship. The plugin bundles dompdf, and the
# package is built by running `composer install --no-dev` against the archive:
# without those two files there is nothing to build it from, and a reviewer
# reading the plugin has no way to see what the vendor directory is.

# Nothing below belongs in the distributed plugin.
# .gitkeep included: they hold empty directories open in git, and the plugin
# directory rejects hidden files outright.
.gitkeep export-ignore
/.github export-ignore
/.wordpress-org export-ignore
/tests export-ignore
/docs export-ignore
/scripts export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.editorconfig export-ignore
/phpcs.xml.dist export-ignore
/phpstan.neon.dist export-ignore
/phpunit.xml.dist export-ignore
/README.md export-ignore
