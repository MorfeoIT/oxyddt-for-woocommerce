* text=auto eol=lf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.zip binary

# Verbatim FSF text. Nothing here reformats it.
/LICENSE -text

# Nothing below belongs in the distributed plugin.
# .gitkeep included: they hold empty directories open in git, and the plugin
# directory rejects hidden files outright.
.gitkeep export-ignore
/.github export-ignore
/.wordpress-org export-ignore
/tests export-ignore
/docs export-ignore
/scripts export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.editorconfig export-ignore
/composer.json export-ignore
/composer.lock export-ignore
/phpcs.xml.dist export-ignore
/phpstan.neon.dist export-ignore
/phpunit.xml.dist export-ignore
/README.md export-ignore
