<?xml version="1.0"?>
<ruleset name="OxyDDT">
    <description>WordPress coding standards for OxyDDT.</description>

    <file>src</file>
    <file>oxyddt-for-woocommerce.php</file>
    <file>uninstall.php</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="ps"/>

    <rule ref="WordPress">
        <!-- src/ is PSR-4, which is what makes the plugin's own autoloader and
             Composer's interchangeable. The WordPress one-class-per-
             lowercase-file convention cannot apply to it. -->
        <exclude name="WordPress.Files.FileName"/>
    </rule>

    <config name="minimum_wp_version" value="6.5"/>
    <config name="testVersion" value="8.1-"/>

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="oxyddt-for-woocommerce"/>
            </property>
        </properties>
    </rule>

    <!-- "oxyddt" is the plugin's public prefix for options, hooks, capabilities,
         database tables and the REST namespace. The bare "oxy_" of the original
         specification is deliberately not used: three characters is below what
         the plugin directory considers unique, and it collides by sight with the
         Oxygen Builder ecosystem. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="Oxysoft\OxyDDT"/>
                <element value="oxyddt"/>
                <element value="OXYDDT"/>
            </property>
        </properties>
    </rule>

    <!--
        No exclude-pattern for any security sniff here, on purpose. The plugin
        directory's own Plugin Check reads the code and ignores this file, so a
        rule relaxed here would look clean locally and fail review. Where a sniff
        genuinely does not apply, the code says so inline, where both tools see it.
    -->

    <!--
        This sniff compares a @param type against the PHP type hint and does not
        understand PHPDoc generics, so it reports "list<Line>" against "array" as
        a mismatch. PHPStan checks the same thing properly at level 8.
    -->
    <rule ref="Squiz.Commenting.FunctionComment.IncorrectTypeHint">
        <severity>0</severity>
    </rule>
</ruleset>
