parameters:
    level: 8
    paths:
        - src
        - oxyddt-for-woocommerce.php
        - uninstall.php
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    scanFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # ABSPATH is a placeholder during analysis, so the upgrade.php that
        # dbDelta() lives in cannot be found on disk. It exists in every real
        # WordPress install; there is nothing to fix here.
        -
            identifier: requireOnce.fileNotFound
            path: src/Infrastructure/Migrator.php
        -
            identifier: requireOnce.fileNotFound
            path: src/Pdf/PdfStore.php
