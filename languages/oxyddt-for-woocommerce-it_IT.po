#: src/Admin/SettingsScreen.php:84
msgid "Settings"
msgstr "Impostazioni"

#: src/Admin/SettingsScreen.php:128
#: src/Admin/SettingsScreen.php:600
msgid "Choose the logo"
msgstr "Scegli il logo"

#: src/Admin/SettingsScreen.php:129
msgid "Use this image"
msgstr "Usa questa immagine"

#: src/Admin/SettingsScreen.php:142
#: src/Admin/SettingsScreen.php:407
msgid "You are not allowed to change these settings."
msgstr "Non hai i permessi per cambiare queste impostazioni."

#: src/Admin/SettingsScreen.php:155
msgid "Sender"
msgstr "Mittente"

#: src/Admin/SettingsScreen.php:156
msgid "Printed at the top of every delivery note, and copied into each document as it is issued. Changing it later does not rewrite documents already issued."
msgstr "Stampato in cima a ogni DDT e copiato dentro ogni documento al momento dell'emissione. Cambiarlo dopo non riscrive i documenti già emessi."

#: src/Admin/SettingsScreen.php:160
msgid "Registered name"
msgstr "Ragione sociale"

#: src/Admin/SettingsScreen.php:161
msgid "VAT number (partita IVA)"
msgstr "Partita IVA"

#: src/Admin/SettingsScreen.php:161
msgid "Eleven digits. The country prefix and any spaces are removed when it is saved."
msgstr "Undici cifre. Il prefisso della nazione e gli spazi vengono tolti al salvataggio."

#: src/Admin/SettingsScreen.php:162
msgid "Tax code (codice fiscale)"
msgstr "Codice fiscale"

#: src/Admin/SettingsScreen.php:162
msgid "For most companies this is the same as the VAT number. One of the two is required."
msgstr "Per la maggior parte delle aziende coincide con la partita IVA. Uno dei due è obbligatorio."

#: src/Admin/SettingsScreen.php:166
msgid "Telephone"
msgstr "Telefono"

#: src/Admin/SettingsScreen.php:167
msgid "Email"
msgstr "Email"

#: src/Admin/SettingsScreen.php:173
msgid "Where the goods leave from"
msgstr "Da dove parte la merce"

#: src/Admin/SettingsScreen.php:174
msgid "Only when it is not the registered address. Leave it empty and the registered address is printed. More than one warehouse is a PRO feature."
msgstr "Solo se non è la sede legale. Lascialo vuoto e viene stampata la sede legale. Più magazzini sono una funzione PRO."

#: src/Admin/SettingsScreen.php:192
msgid "Deleting the plugin"
msgstr "Eliminazione del plugin"

#: src/Admin/SettingsScreen.php:193
msgid "Stored documents"
msgstr "Documenti archiviati"

#: src/Admin/SettingsScreen.php:196
msgid "When OxyDDT is deleted, also delete its delivery notes, numbering and log"
msgstr "Quando OxyDDT viene eliminato, elimina anche i suoi DDT, la numerazione e il registro"

#: src/Admin/SettingsScreen.php:197
msgid "Off by default, and it should stay off. Delivery notes are accounting records, and deleting a plugin is often just a way of testing something. Switching the plugin off never removes anything, whatever this says."
msgstr "Disattivato di default, ed è meglio che resti così. I DDT sono documenti contabili, e disinstallare un plugin spesso è solo un modo per provare qualcosa. Disattivare il plugin non toglie mai niente, qualunque cosa dica questa casella."

#: src/Admin/SettingsScreen.php:381
msgid "The sender is complete."
msgstr "Il mittente è completo."

#: src/Admin/SettingsScreen.php:387
msgid "The sender is not complete yet. Delivery notes cannot be issued until it is:"
msgstr "Il mittente non è ancora completo. Finché non lo è non si possono emettere DDT:"

#: src/Admin/SettingsScreen.php:453
msgid "Saved."
msgstr "Salvato."

#: src/Admin/SettingsScreen.php:454
msgid "Saved. The sender is not complete yet, so no delivery note can be issued."
msgstr "Salvato. Il mittente non è ancora completo, quindi non si può emettere nessun DDT."

#: src/Admin/SettingsScreen.php:507
msgid "The registered name is missing."
msgstr "Manca la ragione sociale."

#: src/Admin/SettingsScreen.php:508
msgid "Either a VAT number or a tax code is required."
msgstr "Serve la partita IVA oppure il codice fiscale."

#: src/Admin/SettingsScreen.php:509
msgid "The VAT number is not a valid partita IVA."
msgstr "La partita IVA non è valida."

#: src/Admin/SettingsScreen.php:510
msgid "The tax code is not a valid codice fiscale."
msgstr "Il codice fiscale non è valido."

#: src/Admin/SettingsScreen.php:511
msgid "The email address is not valid."
msgstr "L'indirizzo email non è valido."

#: src/Admin/SettingsScreen.php:512
msgid "the street is missing"
msgstr "manca l'indirizzo"

#: src/Admin/SettingsScreen.php:513
msgid "the town is missing"
msgstr "manca il comune"

#: src/Admin/SettingsScreen.php:514
msgid "the CAP has to be five digits"
msgstr "il CAP deve essere di cinque cifre"

#: src/Admin/SettingsScreen.php:515
msgid "the province has to be two letters"
msgstr "la provincia deve essere di due lettere"

#: src/Admin/SettingsScreen.php:516
msgid "the country code has to be two letters"
msgstr "il codice della nazione deve essere di due lettere"

#. translators: %s: what is wrong, for example "the CAP has to be five digits".
#: src/Admin/SettingsScreen.php:537
#, php-format
msgid "Where the goods leave from: %s."
msgstr "Da dove parte la merce: %s."

#. translators: %s: what is wrong, for example "the CAP has to be five digits".
#: src/Admin/SettingsScreen.php:542
#, php-format
msgid "Registered address: %s."
msgstr "Sede legale: %s."

#: src/Admin/SettingsScreen.php:581
