#. Description of the plugin
#: oxyddt-for-woocommerce.php
msgid "Issue Italian delivery notes (documenti di trasporto) from WooCommerce orders: partial fulfilment, protected numbering, immutable issued documents and PDF."
msgstr "Emetti documenti di trasporto dagli ordini WooCommerce: evasione parziale, numerazione protetta, documenti immutabili dopo l'emissione e PDF."

#. translators: 1: required PHP version, 2: required WordPress version.
#: oxyddt-for-woocommerce.php:158
#, php-format
msgid "OxyDDT needs PHP %1$s or later and WordPress %2$s or later. It has not been started."
msgstr "OxyDDT richiede PHP %1$s o successivo e WordPress %2$s o successivo. Non è stato avviato."

#: src/Admin/DocumentActions.php:118
#: src/Admin/RegisterScreen.php:91
#: src/Admin/Screen.php:70
msgid "You are not allowed to see delivery notes."
msgstr "Non hai i permessi per vedere i DDT."

#: src/Admin/DocumentActions.php:128
#: src/Admin/DocumentActions.php:215
#: src/Admin/EditScreen.php:489
msgid "That delivery note does not exist."
msgstr "Quel DDT non esiste."

#: src/Admin/DocumentActions.php:141
msgid "The PDF could not be produced. The site log has the details."
msgstr "Non è stato possibile produrre il PDF. I dettagli sono nel log del sito."

#: src/Admin/DocumentActions.php:191
msgid "You are not allowed to send delivery notes."
msgstr "Non hai i permessi per inviare i DDT."

#: src/Admin/DocumentActions.php:225
msgid "Not sent: check the address, and that the delivery note has been issued."
msgstr "Non inviato: controlla l'indirizzo e che il DDT sia stato emesso."

#. translators: %s: the email address.
#: src/Admin/DocumentActions.php:236
#, php-format
msgid "Sent to %s."
msgstr "Inviato a %s."

#: src/Admin/DocumentActions.php:239
msgid "This site could not send the email. That is a mail problem, not a delivery note problem: the document is unchanged."
msgstr "Il sito non è riuscito a inviare l'email. È un problema di posta, non del DDT: il documento non è cambiato."

#: src/Admin/EditScreen.php:167
#: src/Admin/EditScreen.php:312
#: src/Admin/EditScreen.php:569
msgid "You are not allowed to prepare delivery notes."
msgstr "Non hai i permessi per preparare i DDT."

#: src/Admin/EditScreen.php:193
#: src/Admin/Menu.php:81
#: src/Admin/Menu.php:82
#: templates/pdf/document.php:137
msgid "Delivery note"
msgstr "DDT"

#: src/Admin/EditScreen.php:195
msgid "That order does not exist, so there is nothing to prepare a delivery note from."
msgstr "Quell'ordine non esiste, quindi non c'è niente da cui preparare un DDT."

#. translators: %s: order number.
#: src/Admin/EditScreen.php:207
#, php-format
msgid "New delivery note for order %s"
msgstr "Nuovo DDT per l'ordine %s"

#. translators: 1: document number or "draft", 2: order number.
#: src/Admin/EditScreen.php:214
#, php-format
msgid "Delivery note %1$s for order %2$s"
msgstr "DDT %1$s per l'ordine %2$s"

#: src/Admin/EditScreen.php:216
#: src/Infrastructure/Labels.php:104
msgid "draft"
msgstr "bozza"

#: src/Admin/EditScreen.php:282
msgid "Save draft"
msgstr "Salva la bozza"

#: src/Admin/EditScreen.php:286
msgid "Save and issue"
msgstr "Salva ed emetti"

#: src/Admin/EditScreen.php:288
msgid "Issuing takes the next number and closes the document. From then on it cannot be changed, only cancelled."
msgstr "Emettere significa prendere il numero successivo e chiudere il documento. Da quel momento non si può più modificare, solo annullare."

#: src/Admin/EditScreen.php:326
msgid "That order does not exist."
msgstr "Quell'ordine non esiste."

#: src/Admin/EditScreen.php:336
msgid "This delivery note has been issued and cannot be changed. Cancel it and prepare another."
msgstr "Questo DDT è stato emesso e non si può modificare. Annullalo e preparane un altro."

#: src/Admin/EditScreen.php:357
msgid "Nothing was going out: put a quantity against at least one line."
msgstr "Non usciva niente: metti una quantità su almeno una riga."

#: src/Admin/EditScreen.php:414
msgid "Draft saved."
msgstr "Bozza salvata."

#: src/Admin/EditScreen.php:415
msgid "Draft saved, for more than the order has left. That was allowed because you are permitted to override it."
msgstr "Bozza salvata, per più di quanto resti sull'ordine. È stato permesso perché hai l'autorizzazione a forzare."

#: src/Admin/EditScreen.php:432
msgid "Saved as a draft: you are not allowed to issue delivery notes."
msgstr "Salvato come bozza: non hai i permessi per emettere i DDT."

#. translators: %s: what is missing, as a list.
#: src/Admin/EditScreen.php:445
#, php-format
msgid "Saved as a draft, but not issued: %s"
msgstr "Salvato come bozza, ma non emesso: %s"

#. translators: %s: the number of the delivery note.
#: src/Admin/EditScreen.php:457
#, php-format
msgid "Issued as %s. It cannot be changed now, only cancelled."
msgstr "Emesso come %s. Ora non si può più modificare, solo annullare."

#: src/Admin/EditScreen.php:473
msgid "You are not allowed to cancel delivery notes."
msgstr "Non hai i permessi per annullare i DDT."

#. translators: %s: the number of the delivery note.
#: src/Admin/EditScreen.php:509
#, php-format
msgid "Delivery note %s is cancelled. Its quantities are back on the order."
msgstr "Il DDT %s è annullato. Le sue quantità sono tornate sull'ordine."

#: src/Admin/EditScreen.php:523
msgid "it has already been issued"
msgstr "è già stato emesso"

#: src/Admin/EditScreen.php:524
msgid "only an issued delivery note can be cancelled"
msgstr "si può annullare solo un DDT emesso"

#: src/Admin/EditScreen.php:525
msgid "a cancellation has to say why"
msgstr "un annullamento deve dire perché"

#: src/Admin/EditScreen.php:526
msgid "a number could not be settled on — try again"
msgstr "non è stato possibile assegnare un numero — riprova"

#: src/Admin/EditScreen.php:527
msgid "nothing is on it"
msgstr "non c'è niente sopra"

#: src/Admin/EditScreen.php:528
msgid "the reason for transport is missing"
msgstr "manca la causale del trasporto"

#: src/Admin/EditScreen.php:529
msgid "the date is missing"
msgstr "manca la data"

#: src/Admin/EditScreen.php:542
msgid "the sender is not complete — see Settings"
msgstr "il mittente non è completo — vedi Impostazioni"

#: src/Admin/EditScreen.php:548
msgid "the recipient or the destination is not complete"
msgstr "il destinatario o la destinazione non è completo"

#: src/Admin/EditScreen.php:585
msgid "That draft could not be deleted. An issued delivery note is cancelled, never deleted."
msgstr "Non è stato possibile eliminare quella bozza. Un DDT emesso si annulla, non si elimina mai."

#: src/Admin/EditScreen.php:596
msgid "Draft deleted."
msgstr "Bozza eliminata."

#. translators: 1: product name, 2: quantity still available.
#: src/Admin/EditScreen.php:642
#, php-format
msgid "%1$s: %2$s left"
msgstr "%1$s: ne restano %2$s"

#. translators: %s: list of products and their remaining quantities.
#: src/Admin/EditScreen.php:650
#, php-format
msgid "Nothing was saved: the order does not have that much left. %s."
msgstr "Non è stato salvato niente: sull'ordine non resta tanta merce. %s."

