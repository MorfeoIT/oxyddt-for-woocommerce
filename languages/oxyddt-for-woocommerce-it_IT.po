#: src/Admin/Menu.php:66
#: src/Admin/OrderMetabox.php:71
#: src/Admin/Screen.php:79
msgid "Delivery notes (DDT)"
msgstr "Documenti di trasporto (DDT)"

#: src/Admin/Menu.php:67
msgid "DDT"
msgstr "DDT"

#: src/Admin/NumberingScreen.php:102
#: src/Admin/NumberingScreen.php:135
msgid "Numbering"
msgstr "Numerazione"

#: src/Admin/NumberingScreen.php:121
#: src/Admin/NumberingScreen.php:196
msgid "You are not allowed to change how delivery notes are numbered."
msgstr "Non hai i permessi per cambiare la numerazione dei DDT."

#: src/Admin/NumberingScreen.php:136
msgid "The next delivery note will be:"
msgstr "Il prossimo DDT sarà:"

#: src/Admin/NumberingScreen.php:141
msgid "Next number"
msgstr "Prossimo numero"

#: src/Admin/NumberingScreen.php:145
msgid "Set this before you issue anything, if you are coming from another system and your last delivery note was number 347. Lowering it below a number already used will be refused when that number comes round again: the register will not hold the same number twice."
msgstr "Impostalo prima di emettere qualcosa, se arrivi da un altro gestionale e il tuo ultimo DDT era il 347. Abbassarlo sotto un numero già usato verrà rifiutato quando quel numero tornerà: il registro non tiene due volte lo stesso numero."

#: src/Admin/NumberingScreen.php:149
msgid "How it is written"
msgstr "Come si scrive"

#: src/Admin/NumberingScreen.php:153
msgid "Use {number}, {year}, {year2} and {series}. For example {number}/{year} gives 125/2026, and DDT-{year}-{number} gives DDT-2026-125."
msgstr "Usa {number}, {year}, {year2} e {series}. Per esempio {number}/{year} dà 125/2026, e DDT-{year}-{number} dà DDT-2026-125."

#: src/Admin/NumberingScreen.php:157
msgid "Leading zeros"
msgstr "Zeri iniziali"

#: src/Admin/NumberingScreen.php:160
msgid "Five gives 00125. Zero gives 125."
msgstr "Cinque dà 00125. Zero dà 125."

#: src/Admin/NumberingScreen.php:163
msgid "Series"
msgstr "Sezionale"

#: src/Admin/NumberingScreen.php:167
msgid "Leave this empty unless you know you need it. One shop, one series. Several series at once is a PRO feature."
msgstr "Lascialo vuoto se non sai di averne bisogno. Un negozio, un sezionale. Più sezionali insieme sono una funzione PRO."

#: src/Admin/NumberingScreen.php:171
msgid "Each January"
msgstr "Ogni gennaio"

#: src/Admin/NumberingScreen.php:174
msgid "Start counting again from one"
msgstr "Ricomincia a contare da uno"

#: src/Admin/NumberingScreen.php:176
msgid "On by default, which is what most Italian shops do. A delivery note belongs to the year printed on it, not to the day it was issued: one dated the 31st of December and issued on the 2nd of January counts against the old year."
msgstr "Attivo di default, come fa la maggior parte dei negozi italiani. Un DDT appartiene all'anno stampato sopra, non al giorno in cui è stato emesso: uno datato 31 dicembre ed emesso il 2 gennaio conta sull'anno vecchio."

#. translators: %s: the next number, as it will be printed.
#: src/Admin/NumberingScreen.php:250
#, php-format
msgid "Saved. The next delivery note will be %s."
msgstr "Salvato. Il prossimo DDT sarà %s."

