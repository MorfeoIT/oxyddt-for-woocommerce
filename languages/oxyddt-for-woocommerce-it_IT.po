msgstr "Mittente"

msgid "The recipient"
msgstr "Destinatario"

msgid "A carrier"
msgstr "Vettore"

msgid "Prepaid (the sender pays)"
msgstr "Franco (paga il mittente)"

msgid "Forward (the recipient pays)"
msgstr "Assegnato (paga il destinatario)"

msgid "issued"
msgstr "emesso"

msgid "cancelled"
msgstr "annullato"

msgid "Fully sent"
msgstr "Completamente evaso"

msgid "Partly sent"
msgstr "Parzialmente evaso"

msgid "Nothing sent yet"
msgstr "Non ancora evaso"

msgid "OxyDDT needs WooCommerce %1$s or later. This site runs %2$s, so OxyDDT has not been started."
msgstr "OxyDDT richiede WooCommerce %1$s o successivo. Questo sito ha la %2$s, quindi OxyDDT non è stato avviato."

msgid "OxyDDT needs WooCommerce, which is not active. No delivery note can be issued until it is."
msgstr "OxyDDT richiede WooCommerce, che non è attivo. Finché non lo è non si può emettere nessun DDT."

msgid "%1$s — delivery note %2$s"
msgstr "%1$s — DDT %2$s"

msgid ""
"Dear %1$s,\n"
"\n"
"attached is delivery note %2$s of %3$s for the goods on their way to you.\n"
"\n"
"Kind regards,\n"
"%4$s"
msgstr ""
"Spettabile %1$s,\n"
"\n"
"in allegato il DDT %2$s del %3$s relativo alla merce in viaggio verso di voi.\n"
"\n"
"Cordiali saluti,\n"
"%4$s"

